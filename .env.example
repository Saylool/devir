# Local development uses .devir-data automatically. For Vercel, connect a
# PRIVATE Blob store to the project. Its credentials are injected by Vercel.
# BLOB_READ_WRITE_TOKEN=

# Optional: compatible HTTPS chat-completions provider with tool calling.
# The public demo uses the rules engine; no LLM key is required.
# DEVIR_LLM_BASE_URL=https://your-provider.example/v1
# DEVIR_LLM_MODEL=
# DEVIR_LLM_API_KEY=
